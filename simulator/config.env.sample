# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# From: Azure Portal → Event Hubs → Shared Access Policies → SimulatorSend → Connection string–primary key
EVENTHUB_CONNECTION_STRING=Endpoint=sb://<YOUR_NAMESPACE>.servicebus.windows.net/;SharedAccessKeyName=SimulatorSend;SharedAccessKey=<YOUR_KEY>

# Name of the Event Hub (default: transactions)
EVENTHUB_NAME=transactions
